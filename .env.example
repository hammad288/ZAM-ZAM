# ============================================================
# ZAMZAM TOURS & TRAVELS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# --- Database ---
# PostgreSQL connection string
# Example (local):  postgresql://postgres:password@localhost:5432/zamzam
# Example (Neon):   postgresql://user:pass@ep-xxx.region.aws.neon.tech/zamzam?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/zamzam"

# --- Auth.js (NextAuth) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here"
AUTH_URL="http://localhost:3000"

# --- Admin Credentials (used in seed) ---
ADMIN_EMAIL="admin@zamzamtours.com"
ADMIN_PASSWORD="Admin@123456"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
